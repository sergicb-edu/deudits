{
  "name": "mecano",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicació educativa de mecanografia gamificada en català (Google Apps Script + Svelte/TS)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": " npm run build:student && npm run build:admin && npm run build:server",
    "build:student": "vite build --config vite.student.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/google-apps-script": "^1.0.83",
    "@types/node": "^22.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0",
    "vitest": "^2.1.0"
  }
}
